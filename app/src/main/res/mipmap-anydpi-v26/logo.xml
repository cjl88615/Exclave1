<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <!-- avoid referencing @mipmap/logo (self-reference) which causes missing icon in APK;
         use existing launcher foreground and launcher as foreground/monochrome layers -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher"/>
</adaptive-icon>